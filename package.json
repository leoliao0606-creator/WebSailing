{
  "name": "windchaser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "逐风 WindChaser — 3D 小型稳向板帆船拟真游戏",
  "author": "WindChaser contributors",
  "desktopName": "windchaser.desktop",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:multiplayer": "node tools/test-multiplayer.mjs",
    "test:desktop": "npm run build && node tools/test-desktop.mjs",
    "signal": "node server/index.js",
    "serve": "node server/index.js",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "desktop": "npm run build && electron .",
    "desktop:run": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "polar": "node tools/polar.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "three": "^0.180.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "vite": "^7.1.0"
  }
}
